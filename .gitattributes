# 统一换行符：仓库内一律 LF，检出时按平台转换
* text=auto eol=lf

# 明确文本类型
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
LICENSE text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf

# 二进制文件
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.pptx  binary
